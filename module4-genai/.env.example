# Copia este archivo a .env y rellena los valores.
# cp .env.example .env

# --- Gemini API — embeddings multimodales (notebooks 01–03) ---
# Consigue una key en https://aistudio.google.com/apikey
# El SDK google-genai la lee automáticamente de GEMINI_API_KEY (o GOOGLE_API_KEY).
GEMINI_API_KEY=
# gemini-embedding-2 es multimodal: texto e imágenes en el MISMO espacio vectorial.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Dimensiones recomendadas: 768, 1536 o 3072 (MRL). 768 es un buen equilibrio.
EMBEDDING_DIM=768

# --- Ollama cloud — LLM de generación (notebooks 01–03) ---
# Consigue una key en https://ollama.com/settings/keys
# El MODELO se elige en los notebooks (variable OLLAMA_MODEL de la celda del
# LLM); aquí solo van credenciales y endpoint.
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com

# --- Qdrant — base de datos vectorial ---
# Inicia Qdrant con: cd qdrant && docker compose up -d
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=tecnomarket
